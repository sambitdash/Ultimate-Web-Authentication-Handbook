{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ch5 hr frontend",
      "command": "flutter",
      "args": ["build", "web"],
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/chapter-5/hr/frontend"},
    },
    {
      "label": "ch5 hr delay frontend",
