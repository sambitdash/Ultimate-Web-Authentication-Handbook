    {
      "label": "ch10 frontend",
      "type": "shell",
      "windows": {
        "command": "echo 'ERROR: This script must be run inside a WSL window!'; exit 1"
      },
      "linux": {
        "command": "sudo apt-get update && sudo apt-get install -y g++ libdlib-dev libblas-dev libatlas-base-dev liblapack-dev libjpeg-turbo8-dev && flutter build web",
        "options": {
          "cwd": "${workspaceFolder}/chapter-10/frontend"
        },
        "console": "externalTerminal"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
  ],
  "inputs": [
    {
      "id": "sudoPassword",
      "description": "Enter your Linux sudo password",
      "type": "promptString",
      "password": true
    }
